{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vpmftefelrlquadcmxoj.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "northstar-labs",
      "version": "0.1.0",
      "title": "Northstar Labs"
    },
    "tools": [
      {
        "name": "list_proposals",
        "title": "List proposals",
        "description": "List NorthStar Labs client proposals visible to the signed-in operator, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional proposal status filter, e.g. draft, sent, accepted.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of proposals to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_assessment_requests",
        "title": "List assessment requests",
        "description": "List inbound assessment requests from the public NorthStar Labs website, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional status filter, e.g. new, reviewed, converted.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of requests to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_projects",
        "title": "List delivery projects",
        "description": "List client delivery projects visible to the signed-in user, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional project status filter, e.g. planned, active, completed.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of projects to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "billing_summary",
        "title": "Billing summary",
        "description": "Summarize recent invoices: totals billed, totals collected, and outstanding balance.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 50,
              "description": "How many recent invoices to include in the summary.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "update_assessment_request",
        "title": "Update assessment request",
        "description": "Update the review status and operator notes on an inbound assessment request.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The assessment request id."
            },
            "status": {
              "description": "New review status.",
              "type": "string",
              "enum": [
                "new",
                "reviewed",
                "converted",
                "archived"
              ]
            },
            "operator_notes": {
              "description": "Internal operator notes to store on the request.",
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
